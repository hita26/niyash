# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/niyanshPharma?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/niyanshPharma

# JWT Authentication Secret (Use a strong, unique secret in production)
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Initial Admin Passwords (used when auto-seeding defaults if not yet created)
SUPERADMIN_PASSWORD=change_this_superadmin_password
ADMIN_PASSWORD=change_this_admin_password

# Outgoing SMTP Email Configuration (Port 465 SSL or 587 TLS)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@niyanshpharma.com
SMTP_PASS=your_smtp_mailbox_password_here
EMAIL_FROM="Niyansh Pharma Wholesale" <info@niyanshpharma.com>

# Cloudinary Cloud Storage Configuration (Product Catalog Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Prompt ERP Desktop Sync Secret Key
ERP_SYNC_SECRET=your_strong_erp_sync_secret_key_here

# Google Gemini Generative AI Key (Optional)
GEMINI_API_KEY=
