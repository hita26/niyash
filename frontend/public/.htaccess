# ----------------------------------------------------------------------
# Single Page Application (SPA) Apache Rewrite Configuration
# Niyansh Pharma (cPanel / Apache)
# ----------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Let /api requests pass directly to GoDaddy Node.js App (Passenger)
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/api$
  RewriteRule ^ - [L]

  # 2. Directly intercept /products and /products/ and rewrite to index.html immediately
  RewriteRule ^products/?$ /index.html [L,QSA]

  # 3. Never rewrite physical files that actually exist (images, css, js, fonts, pdf, php, json)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Route all other requests (including any directory request without a file) to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Safety ErrorDocuments for 403 and 404 - Always load React App
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
