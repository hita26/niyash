</html><script>
    $.Tween.propHooks.number = {
        get: function(tween) {
            var num = tween.elem.innerHTML.replace(/^[^\d-]+/, "");
            return parseFloat(num) || 0;
        },

        set: function(tween) {
            var opts = tween.options;
            tween.elem.innerHTML =
                (opts.prefix || "") +
                tween.now.toFixed(opts.fixed || 0) +
                (opts.postfix || "");
        }
    };

    $("#num-1").animate({
        number: 358
    }, {
        duration: 3000
        //postfix: "+"
    });

    $("#num-2")

        .animate({
            number: 75
        }, {
            duration: 3000
            //postfix: "+"
        });

    $("#num-3")

        .animate({
            number: 670
        }, {
            duration: 3000,
            // postfix: "+"
        });

    $("#num-4")

        .animate({
            number: 350000
        }, {
            duration: 3000,
            // postfix: "+"
        });
</script>
