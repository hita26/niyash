{
  "name": "niyansh-pharma",
  "version": "1.0.0",
  "description": "Niyansh Pharma Wholesale Distribution Website",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "echo 'Frontend pre-built in frontend/dist'",
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node backend/scripts/seedData.js",
    "pull": "git pull origin main",
    "push": "git add -A && git commit -m \"update\" && git push origin main"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.7.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1"
  }
}
